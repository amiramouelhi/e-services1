generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Statut {
  CERTIFIE
  EN_ATTENTE_RENOUVELLEMENT
}

enum AutorisationStatut {
  EN_COURS_EXAMEN
  EN_COURS_TRAITEMENT
  EN_ATTENTE_PAIEMENT
  PAIEMENT_RECU
  AUTORISE
}

model User {
  id                        Int       @id @default(autoincrement())
  fullName                  String
  email                     String    @unique
  password                  String
  createdAt                 DateTime  @default(now())
  canDepot                  Boolean   @default(false)
  canFCS                    Boolean   @default(false)
  emailVerified              Boolean   @default(false)
  verificationCode           String?
  verificationCodeExpiresAt  DateTime?
  passwordResetCode          String?
  passwordResetCodeExpiresAt DateTime?
  depots                     Depot[]
}

model Admin {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
}

model Categorie {
  id      Int      @id @default(autoincrement())
  code    Int      @unique
  nom_fr  String
  nom_ar  String

  oeuvres Oeuvre[]
}

model Deposant {
  id               Int     @id @default(autoincrement())
  nomComplet_fr    String?
  nomComplet_ar    String?
  cin              String? @unique
  raisonSociale    String? @unique
  registreCommerce String?
  representantLegal String?
  rue          String?
  cite         String?
  gouvernorat  String?
  ville        String?
  codePostal   String?
  telephone        String?
  fax              String?
  email            String?
  fichierCIN             String?
  fichierRNE             String?
  fichierProcuration     String?
  fichierDossierJuridique String?
  typeDeposant           String?  // "PHYSIQUE" or "MORALE"
  isAuteur    Boolean? @default(false)
  isNon       Boolean? @default(false)
  isCoAuteur  Boolean? @default(false)
  depots           Depot[]
}

model Auteur {
  id            Int     @id @default(autoincrement())
  nomComplet_fr String?
  nomComplet_ar String?

  depotAuteurs  DepotAuteur[]
}

model Oeuvre {
  id             Int       @id @default(autoincrement())
  titre_fr       String?
  titre_ar       String?
  description_fr String?
  description_ar String?
  typeSupport_fr String?
  typeSupport_ar String?
  categorieId    Int
  categorie      Categorie @relation(fields: [categorieId], references: [id])

  depots         Depot[]
}

model Organisateur {
  id             Int      @id @default(autoincrement())
  nom            String
  mf             String?
  rne            String?
  adresse        String?
  telephone      String?
  fax            String?
  email          String?
  nomResponsable String?
  createdAt      DateTime @default(now())

  autorisations AutorisationSpectacle[]
}

model AutorisationSpectacle {
  id                    Int       @id @default(autoincrement())
  numeroAutorisation    String?
  dateDemande           DateTime?
  isOrganisateur        Boolean   @default(false)
  sfat                  String?
  hasArtistesEtrangers  Boolean   @default(false)
  dateCommission        DateTime?
  pvCommission          String?
  nombreSpectacles      Int       @default(1)
  fichierFacture        String?
  numeroFacture         String?   // ← add this
  dateCreation          DateTime  @default(now())
  statut                AutorisationStatut @default(EN_COURS_EXAMEN)
  prisEnChargeAt        DateTime?
  paiementProofUrl      String?
  paiementRecuAt        DateTime?
  authoriseAt           DateTime?

  organisateurId        Int?
  organisateur          Organisateur? @relation(fields: [organisateurId], references: [id])

  spectacles            Spectacle[]
}

model Spectacle {
  id               Int       @id @default(autoincrement())
  categorieSpectacle String?
titreSpectacle     String?
espaceSpectacle    String?
  dateSpectacle    DateTime
  horaireSpectacle String?
  lieuSpectacle    String
  typeSpectacle    String    // 'individuel' or 'manifestation'
  budget           Decimal?
  natureManif      String?   // 'locale', 'regionale', 'nationale', 'internationale'
  hasEtrangers     Boolean?

  autorisationId   Int
  autorisation     AutorisationSpectacle @relation(fields: [autorisationId], references: [id], onDelete: Cascade)

  artistes         Artiste[]
}

model Artiste {
  id          Int     @id @default(autoincrement())
  nom         String
  nationalite String  // 'tunisienne' or 'autre'
  pays        String?
  identite    String? // file path

  spectacleId Int
  spectacle   Spectacle @relation(fields: [spectacleId], references: [id], onDelete: Cascade)

  depenses    Depense[]
}

model Depense {
  id       Int     @id @default(autoincrement())
  type     String
  montant  Decimal @default(0)
  fichier  String? // file path

  artisteId Int
  artiste   Artiste @relation(fields: [artisteId], references: [id], onDelete: Cascade)
}

model Depot {
  id                         Int       @id @default(autoincrement())
  numeroSequentiel           Int?
  numeroEnregistrementBureau String?
  numeroRegistreInterne      String?
  dateDepot                  DateTime
  numeroRecuPaiement         String?
  montant                    Decimal   @default(30)
  numeroCertificat           String?
  dateEmissionCertificat     DateTime?
  dateReceptionCertificat    DateTime?
  dateCreation               DateTime  @default(now())
  dateExpiration            DateTime?
  dateRenouvellement        DateTime?
  fichierDemandeRenouvellement String?
  statut                     Statut    @default(CERTIFIE)
  konnectPaymentRef          String?
  motifRejet      String?
  fichierFacture  String?
  userId     Int
  user       User     @relation(fields: [userId], references: [id])

  deposantId Int
  deposant   Deposant @relation(fields: [deposantId], references: [id])

  oeuvreId   Int
  oeuvre     Oeuvre   @relation(fields: [oeuvreId], references: [id])
  
  auteurs    DepotAuteur[]
}

model DepotAuteur {
  depotId  Int
  auteurId Int

  depot  Depot  @relation(fields: [depotId], references: [id], onDelete: Cascade)
  auteur Auteur @relation(fields: [auteurId], references: [id], onDelete: Cascade)

  @@id([depotId, auteurId])
}
