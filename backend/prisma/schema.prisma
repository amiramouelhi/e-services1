generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Statut {
  EN_ATTENTE   
  ACCEPTE      
  REJETE      
  PAYE         
  CERTIFIE
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  depots    Depot[]
}

model Admin {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
}

model Categorie {
  id      Int      @id @default(autoincrement())
  code    Int      @unique
  nom_fr  String
  nom_ar  String

  oeuvres Oeuvre[]
}

model Deposant {
  id               Int     @id @default(autoincrement())
  nomComplet_fr    String?
  nomComplet_ar    String?
  cin              String? @unique
  raisonSociale    String? @unique
  registreCommerce String?
  rue          String?
  cite         String?
  gouvernorat  String?
  ville        String?
  codePostal   String?
  telephone        String?
  fax              String?
  email            String?
  fichierCIN             String?
  fichierRNE             String?
  fichierProcuration     String?
  fichierDossierJuridique String?
  typeDeposant           String?  // "PHYSIQUE" or "MORALE"
  isAuteur    Boolean? @default(false)
  isNon       Boolean? @default(false)
  isCoAuteur  Boolean? @default(false)
  depots           Depot[]
}

model Auteur {
  id            Int     @id @default(autoincrement())
  nomComplet_fr String?
  nomComplet_ar String?

  depotAuteurs  DepotAuteur[]
}

model Oeuvre {
  id             Int       @id @default(autoincrement())
  titre_fr       String?
  titre_ar       String?
  description_fr String?
  description_ar String?
  typeSupport_fr String?
  typeSupport_ar String?
  categorieId    Int
  categorie      Categorie @relation(fields: [categorieId], references: [id])

  depots         Depot[]
}


model Depot {
  id                         Int       @id @default(autoincrement())
  numeroSequentiel           Int?
  numeroEnregistrementBureau String?
  numeroRegistreInterne      String?
  dateDepot                  DateTime
  numeroRecuPaiement         String?
  montant                    Decimal   @default(30)
  numeroCertificat           String?
  dateEmissionCertificat     DateTime?
  dateReceptionCertificat    DateTime?
  dateCreation               DateTime  @default(now())
  statut                     Statut    @default(EN_ATTENTE)
  konnectPaymentRef          String?
  motifRejet      String?

  userId     Int
  user       User     @relation(fields: [userId], references: [id])

  deposantId Int
  deposant   Deposant @relation(fields: [deposantId], references: [id])

  oeuvreId   Int
  oeuvre     Oeuvre   @relation(fields: [oeuvreId], references: [id])
  
  auteurs    DepotAuteur[]
}

model DepotAuteur {
  depotId  Int
  auteurId Int

  depot  Depot  @relation(fields: [depotId], references: [id], onDelete: Cascade)
  auteur Auteur @relation(fields: [auteurId], references: [id], onDelete: Cascade)

  @@id([depotId, auteurId])
}